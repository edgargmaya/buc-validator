# Copy to terraform.tfvars and fill in values.
# Apply RedisOSS/Secrets-Terraform first so the secret exists.

aws_region = "us-east-1"

subnet_ids = [
  "subnet-aaaaaaaaaaaaaaaaa",
  "subnet-bbbbbbbbbbbbbbbbb",
  "subnet-ccccccccccccccccc",
]

# Name or ARN from Secrets-Terraform output (e.g. secret_arn or secret_name).
redis_auth_secret_id = "redis-oss/auth-token"

# By default Redis is allowed from the VPC CIDR. Disable and use explicit CIDRs only:
# allow_vpc_internal_access = false
# allowed_ingress_cidr_blocks = ["10.0.0.0/8"]

# replication_group_id = "redis-oss-app"
# node_type            = "cache.t4g.micro"
# engine_version       = "7.1"
